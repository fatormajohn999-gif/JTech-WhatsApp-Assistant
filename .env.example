# Port for the Express server (Render sets PORT automatically, defaults to 3000)
PORT=3000

# Dashboard security header: x-pass protection for /api routes
DASHBOARD_PASSWORD="admin_secure_pass_123"

# Upstash Redis REST credentials (from Upstash console)
UPSTASH_REDIS_REST_URL="https://your-database.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_token"

# AI Provider API Keys
GEMINI_API_KEY="your_google_gemini_api_key"
GROQ_API_KEY="your_groq_api_key"

# Bot Configuration (Optional defaults)
BOT_PHONE_NUMBER=""
DEFAULT_PROVIDER="gemini"
SYSTEM_PROMPT="You are a polite, helpful, and concise WhatsApp customer assistant. Answer user queries clearly and accurately in under 3 sentences unless detailed explanation is requested."
NON_TEXT_REPLY="Hello! I am an automated assistant and can only read text messages right now. Please send your message as text, and I'll be happy to assist you! 🙏"
